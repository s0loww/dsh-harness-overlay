{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airules.local/schemas/dsh-ui-component-inventory-v1.json",
  "title": "DSH UI component inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "separation", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "releaseId", "hostVersion", "bundleVersion"],
      "properties": {
        "product": { "const": "DSH Desktop 1C" },
        "releaseId": { "type": "string", "pattern": "^[0-9]{14}$" },
        "hostVersion": { "type": "string", "minLength": 1 },
        "bundleVersion": { "type": "string", "minLength": 1 }
      }
    },
    "separation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "rulepack", "mcpBindings", "credentials", "runtimeState"],
      "properties": {
        "policy": { "const": "excluded" },
        "rulepack": { "const": "excluded" },
        "mcpBindings": { "const": "excluded" },
        "credentials": { "const": "excluded" },
        "runtimeState": { "const": "excluded" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "license", "origin", "redistribution"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "license": { "type": ["string", "null"] },
        "origin": { "enum": ["npm", "github", "bundle-file", "vendor-file"] },
        "redistribution": { "enum": ["confirmed", "review-required", "forbidden"] }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["static", "import", "route", "ui-smoke", "restart-smoke"] },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "category", "owner", "sourcePackages", "dependencies", "statePolicy", "portability", "targetCompatibility", "deployment", "healthChecks", "smokeChecks"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "category": { "enum": ["balance", "settings", "localization", "plugin-panel", "schedules", "mcp-panel", "theme", "companion", "workspace"] },
        "owner": { "enum": ["upstream", "third-party", "bundle-vendor", "private-overlay"] },
        "sourcePackages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/package" } },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["client", "backend", "hostCapabilities"],
          "properties": {
            "client": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "backend": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "hostCapabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        },
        "statePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "credentials", "allowedData", "forbiddenData"],
          "properties": {
            "scope": { "enum": ["none", "browser-local", "machine-user", "project", "runtime"] },
            "credentials": { "enum": ["none", "external-only"] },
            "allowedData": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "forbiddenData": { "type": "array", "minItems": 4, "items": { "type": "string" }, "uniqueItems": true }
          }
        },
        "portability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "status", "rationale"],
          "properties": {
            "mode": { "enum": ["config-only", "package-copy", "vendor-patch", "data-overlay", "reimplement", "not-portable"] },
            "status": { "enum": ["candidate", "audited", "blocked", "deferred"] },
            "rationale": { "type": "string", "minLength": 1 }
          }
        },
        "targetCompatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["releaseIds", "hostVersions", "unknownTargetPolicy"],
          "properties": {
            "releaseIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
            "hostVersions": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
            "unknownTargetPolicy": { "const": "block" }
          }
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "defaultEnabled", "installOrder", "failurePolicy"],
          "properties": {
            "required": { "type": "boolean" },
            "defaultEnabled": { "type": "boolean" },
            "installOrder": { "type": "integer", "minimum": 0 },
            "failurePolicy": { "enum": ["fail-overlay", "disable-component"] }
          }
        },
        "healthChecks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
        "smokeChecks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } }
      }
    }
  }
}
