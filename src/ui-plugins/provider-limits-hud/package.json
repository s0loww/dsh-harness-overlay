{
  "name": "airules-provider-limits-hud",
  "version": "0.1.0",
  "description": "Read-only provider balance and quota HUD for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./core": "./core.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "core.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "PROVENANCE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
